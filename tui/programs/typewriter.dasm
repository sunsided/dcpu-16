; Types keys onto the screen. Enter starts a new line, Backspace deletes,
; and the text scrolls up once the screen is full.
;
; The keyboard writes keys into the ring buffer at 0x9000-0x900f; a key is
; taken by clearing its slot. Screen cells are `ffff bbbb B ccccccc`.

              SET A, title_text
              SET B, 0x8000            ; first row
              SET C, 0xe000            ; yellow
              JSR print
              SET A, hint_text
              SET B, 0x8020            ; second row
              SET C, 0x7000            ; grey
              JSR print

:ready        SET I, 0                 ; next keyboard slot
              SET X, 0x8040            ; cursor, starting on the third row

:wait         SET [X], 0xf0df          ; blinking, white underscore
              SET A, [0x9000+I]
              IFE A, 0
                 SET PC, wait
              SET [0x9000+I], 0        ; take the key
              ADD I, 1
              AND I, 0xf

              IFE A, 0x0a              ; Enter
                 SET PC, newline
              IFE A, 0x08              ; Backspace
                 SET PC, backspace
              IFG A, 0x7e              ; not printable ASCII
                 SET PC, wait
              IFG 0x20, A
                 SET PC, wait

              BOR A, 0xa000            ; green
              SET [X], A
              ADD X, 1
              SET PC, wrap

:newline      SET [X], 0
              AND X, 0xffe0            ; start of the row (rows are 32 cells)
              ADD X, 0x20
              SET PC, wrap

:backspace    IFG X, 0x8040
                 SET PC, back
              SET PC, wait
:back         SET [X], 0
              SUB X, 1
              SET [X], 0
              SET PC, wait

:wrap         IFG X, 0x817f            ; past the last cell
                 SET PC, scroll
              SET PC, wait

; Moves rows three to twelve up by one row and clears the last row.
:scroll       SET Y, 0x8040
:scroll_loop  SET [Y], [Y+0x20]
              ADD Y, 1
              IFG 0x8160, Y
                 SET PC, scroll_loop
:clear        SET [Y], 0
              ADD Y, 1
              IFG 0x8180, Y
                 SET PC, clear
              SET X, 0x8160
              SET PC, wait

; Prints the zero-terminated string at A to the screen at B in color C.
:print        SET X, [A]
              IFE X, 0
                 SET PC, POP
              BOR X, C
              SET [B], X
              ADD A, 1
              ADD B, 1
              SET PC, print

:title_text   DAT "DCPU-16 typewriter", 0
:hint_text    DAT "Type! Enter: new line", 0
